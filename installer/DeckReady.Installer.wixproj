<Project Sdk="WixToolset.Sdk/6.0.0">
  <PropertyGroup>
    <!-- Internal Windows Installer version. Public DeckReady version remains a1.08.0. -->
    <Version>1.8.0</Version>
    <PackageVersion>1.8.0</PackageVersion>
    <DeckReadyReleaseLabel Condition="'$(DeckReadyReleaseLabel)' == ''">a1.08.0</DeckReadyReleaseLabel>

    <OutputName>DeckReady-Windows-$(DeckReadyReleaseLabel)</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <Platform>x64</Platform>

    <DeckReadyReleaseMsiDir>$(MSBuildProjectDirectory)\..\release\msi</DeckReadyReleaseMsiDir>
    <DeckReadyFinalMsi>$(DeckReadyReleaseMsiDir)\DeckReady-Windows-$(DeckReadyReleaseLabel).msi</DeckReadyFinalMsi>
  </PropertyGroup>

  <ItemGroup>
    <!-- Adds the real wizard UI: Welcome, license, optional desktop shortcut, ready, progress, finish. -->
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.0" />
  </ItemGroup>

  <Target Name="CopyDeckReadyMsiToRelease" AfterTargets="Build">
    <Message Importance="high" Text="DeckReady WiX TargetPath: $(TargetPath)" />
    <MakeDir Directories="$(DeckReadyReleaseMsiDir)" />
    <Error Condition="!Exists('$(TargetPath)')" Text="WiX completed but TargetPath does not exist: $(TargetPath)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(DeckReadyFinalMsi)" SkipUnchangedFiles="false" />
    <Error Condition="!Exists('$(DeckReadyFinalMsi)')" Text="MSI copy verification failed: $(DeckReadyFinalMsi)" />
    <Message Importance="high" Text="DeckReady MSI copied to: $(DeckReadyFinalMsi)" />
  </Target>
</Project>
