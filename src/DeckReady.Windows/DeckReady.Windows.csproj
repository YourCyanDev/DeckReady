<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DeckReady</AssemblyName>
    <RootNamespace>DeckReady</RootNamespace>
    <ApplicationIcon>Assets\DeckReady.ico</ApplicationIcon>
    <Version>1.9.0-alpha</Version>
    <FileVersion>1.9.0.0</FileVersion>
    <AssemblyVersion>1.9.0.0</AssemblyVersion>
    <InformationalVersion>a1.09.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\DeckReady.png" />
    <Resource Include="Assets\DeckReady.ico" />
  </ItemGroup>

</Project>
