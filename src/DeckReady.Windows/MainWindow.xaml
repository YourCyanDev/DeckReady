<Window x:Class="DeckReady.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeckReady — Windows Alpha a1.10.0 (Windows build 2)"
        Height="790" Width="1240" MinHeight="650" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource DeckReadyWindow}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}">
            <MenuItem Header="_File">
                <MenuItem Header="_Import Files..." InputGestureText="Ctrl+I" Click="ImportFiles_Click"/>
                <MenuItem Header="Import _Folder..." Click="ImportFolder_Click"/>
                <Separator/>
                <MenuItem Header="Open DeckReady _Inbox" Click="OpenAutoImportFolder_Click"/>
                <MenuItem Header="_Scan Inbox Now" Click="ScanAutoImportFolder_Click"/>
                <MenuItem Header="Open Music _Library" Click="OpenLibraryFolder_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Select Songs" InputGestureText="Ctrl+S" Click="SelectMode_Click"/>
                <MenuItem Header="_Settings..." Click="Settings_Click"/>
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="Scan Serato _Duplicates" Click="ScanSeratoDuplicates_Click"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="DeckReady on _GitHub" Click="OpenGitHub_Click"/>
                <MenuItem Header="DeckReady _Discord" Click="OpenDiscord_Click"/>
                <MenuItem Header="_Report an Issue" Click="ReportIssue_Click"/>
                <Separator/>
                <MenuItem Header="_About DeckReady" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="235"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1D2024" BorderBrush="#34383E" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,16">
                        <TextBlock Text="AUTO IMPORT" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="Bold" Margin="6,12,0,5"/>
                        <TextBlock x:Name="AutoImportStatusText" Text="Checking..." Margin="6,2,0,6" TextWrapping="Wrap"/>
                        <Button Content="Open Inbox" Click="OpenAutoImportFolder_Click" Margin="6,0,6,10"/>

                        <TextBlock Text="SERATO" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="Bold" Margin="6,12,0,5"/>
                        <TextBlock x:Name="SeratoStatusText" Text="Checking..." Margin="6,2,0,8" TextWrapping="Wrap"/>
                        <Button Content="Launch Serato" Click="LaunchSerato_Click" Margin="6,0"/>
                        <TextBlock Text="DeckReady Windows" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="6,18,0,0"/>
                        <TextBlock Text="Alpha a1.10.0 • Windows build 2" Foreground="{StaticResource MutedTextBrush}" FontSize="11" Margin="6,2,0,0"/>
                    </StackPanel>

                    <StackPanel>
                        <Grid Margin="14,18,14,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="40" Height="40" CornerRadius="9" Background="#102925">
                                <Image Source="Assets/DeckReady.png" Stretch="Uniform" Margin="4"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="DeckReady" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </Grid>

                        <TextBlock Text="LIBRARY" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="Bold" Margin="14,8,0,4"/>
                        <Button x:Name="QueueNavButton" Style="{StaticResource NavButton}" Content="⬇  Import Queue" Click="QueueNav_Click"/>
                        <Button x:Name="LibraryNavButton" Style="{StaticResource NavButton}" Content="♫  Music Library" Click="LibraryNav_Click"/>
                        <Button x:Name="NeedsTagsNavButton" Style="{StaticResource NavButton}" Content="⚠  Needs Tag Editing" Click="NeedsTagsNav_Click"/>
                        <Button x:Name="TagEditorNavButton" Style="{StaticResource NavButton}" Content="🏷  Tag Editor" Click="TagEditorNav_Click"/>
                        <Button x:Name="RecentNavButton" Style="{StaticResource NavButton}" Content="↻  Recent Imports" Click="RecentNav_Click"/>
                        <Button x:Name="DuplicatesNavButton" Style="{StaticResource NavButton}" Content="⧉  Import Duplicates" Click="DuplicatesNav_Click"/>

                        <TextBlock Text="SERATO TOOLS" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="Bold" Margin="14,16,0,4"/>
                        <Button x:Name="SeratoDuplicatesNavButton" Style="{StaticResource NavButton}" Content="◎  Serato Duplicates" Click="SeratoDuplicatesNav_Click"/>

                        <TextBlock Text="DECKREADY" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="Bold" Margin="14,16,0,4"/>
                        <Button Style="{StaticResource NavButton}" Content="⚙  Settings" Click="Settings_Click"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#202327" BorderBrush="#34383E" BorderThickness="0,0,0,1" Padding="20,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="PageTitleText" Text="Import Queue" FontSize="23" FontWeight="SemiBold"/>
                            <TextBlock x:Name="PageSubtitleText" Text="Drop songs, folders, or ZIP files here." Foreground="{StaticResource MutedTextBrush}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="AddMusicButton" Content="+ Add Music" Click="ImportFiles_Click"/>
                            <Button x:Name="AddFolderButton" Content="Add Folder" Click="ImportFolder_Click"/>
                            <Button x:Name="ClearFinishedButton" Content="Clear Finished" Click="ClearFinished_Click"/>
                            <Button x:Name="OrganizeLibraryButton" Content="Organize Library" Click="OrganizeLibrary_Click" Visibility="Collapsed"/>
                            <Button x:Name="RefreshLibraryButton" Content="Refresh Library" Click="RefreshLibrary_Click" Visibility="Collapsed"/>
                            <Button x:Name="PlayPauseButton" Content="Play" Click="PlayPause_Click" Visibility="Collapsed"/>
                            <Button x:Name="EditTagsButton" Content="Edit Tags" Click="EditSelectedTags_Click" Visibility="Collapsed"/>
                            <Button x:Name="ScanSeratoButton" Content="Scan Duplicates" Click="ScanSeratoDuplicates_Click" Visibility="Collapsed"/>
                            <Button x:Name="SelectModeButton" Content="Select" Click="SelectMode_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid x:Name="QueuePage">
                        <DataGrid x:Name="QueueGrid" ItemsSource="{Binding QueueItems}" MouseDoubleClick="QueueGrid_MouseDoubleClick" CurrentCellChanged="Grid_CurrentCellChanged">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn x:Name="QueueSelectColumn" Header="✓" Width="42" Visibility="Collapsed">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="SelectionCheckBox_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn IsReadOnly="True" Header="Title" Binding="{Binding DisplayTitle, Mode=OneWay}" Width="2*"/>
                                <DataGridTextColumn IsReadOnly="True" Header="Artist" Binding="{Binding DisplayArtist, Mode=OneWay}" Width="1.5*"/>
                                <DataGridTextColumn IsReadOnly="True" Header="Format" Binding="{Binding Format, Mode=OneWay}" Width="75"/>
                                <DataGridTextColumn IsReadOnly="True" Header="Length" Binding="{Binding DurationText, Mode=OneWay}" Width="75"/>
                                <DataGridTextColumn IsReadOnly="True" Header="State" Binding="{Binding StateText, Mode=OneWay}" Width="120"/>
                                <DataGridTextColumn IsReadOnly="True" Header="Status" Binding="{Binding StatusMessage, Mode=OneWay}" Width="2*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Grid x:Name="LibraryPage" Visibility="Collapsed">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <WrapPanel Margin="0,0,0,10">
                            <TextBlock Text="Artist" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <ComboBox x:Name="LibraryArtistFilter" Width="130" SelectionChanged="LibraryFilter_Changed"/>
                            <TextBlock Text="Genre" VerticalAlignment="Center" Margin="10,0,5,0"/>
                            <ComboBox x:Name="LibraryGenreFilter" Width="110" SelectionChanged="LibraryFilter_Changed"/>
                            <TextBlock Text="Year" VerticalAlignment="Center" Margin="10,0,5,0"/>
                            <ComboBox x:Name="LibraryYearFilter" Width="90" SelectionChanged="LibraryFilter_Changed"/>
                            <TextBlock Text="Format" VerticalAlignment="Center" Margin="10,0,5,0"/>
                            <ComboBox x:Name="LibraryFormatFilter" Width="90" SelectionChanged="LibraryFilter_Changed"/>
                            <TextBlock Text="Sort by" VerticalAlignment="Center" Margin="10,0,5,0"/>
                            <ComboBox x:Name="LibrarySortBox" Width="110" SelectionChanged="LibraryFilter_Changed"/>
                            <CheckBox x:Name="LibraryDescendingCheck" Content="Descending" Checked="LibraryOrder_Changed" Unchecked="LibraryOrder_Changed" VerticalAlignment="Center" Margin="10,0"/>
                            <Button Content="Clear Filters" Click="ClearLibraryFilters_Click"/>
                            <TextBlock Text="Search" VerticalAlignment="Center" Margin="10,0,5,0"/>
                            <TextBox x:Name="LibrarySearchBox" Width="200" TextChanged="LibrarySearch_Changed"/>
                        </WrapPanel>
                        <DataGrid Grid.Row="1" x:Name="LibraryGrid" ItemsSource="{Binding LibraryItems}" MouseDoubleClick="LibraryGrid_MouseDoubleClick" CurrentCellChanged="Grid_CurrentCellChanged">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn x:Name="LibrarySelectColumn" Header="✓" Width="42" Visibility="Collapsed">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="SelectionCheckBox_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn IsReadOnly="True" Header="Title" Binding="{Binding DisplayTitle, Mode=OneWay}" Width="2*"/>
                                <DataGridTextColumn IsReadOnly="True" Header="Artist" Binding="{Binding DisplayArtist, Mode=OneWay}" Width="1.5*"/>
                                <DataGridTextColumn IsReadOnly="True" Header="Album" Binding="{Binding Album, Mode=OneWay}" Width="1.4*"/>
                                <DataGridTextColumn IsReadOnly="True" Header="Format" Binding="{Binding Format, Mode=OneWay}" Width="75"/>
                                <DataGridTextColumn IsReadOnly="True" Header="Length" Binding="{Binding DurationText, Mode=OneWay}" Width="75"/>
                                <DataGridTextColumn IsReadOnly="True" Header="Path" Binding="{Binding FilePath, Mode=OneWay}" Width="2.5*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Grid x:Name="TagEditorPage" Visibility="Collapsed" Margin="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.35*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="0.9*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#1B1E22" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="14,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Tracks" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="Choose a song to edit its embedded metadata." Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Refresh" Click="RefreshLibrary_Click"/>
                                </Grid>
                                <DataGrid Grid.Row="1" x:Name="TagEditorGrid" ItemsSource="{Binding LibraryItems}"
                                          SelectionChanged="TagEditorGrid_SelectionChanged">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn IsReadOnly="True" Header="Title" Binding="{Binding DisplayTitle, Mode=OneWay}" Width="1.7*"/>
                                        <DataGridTextColumn IsReadOnly="True" Header="Artist" Binding="{Binding DisplayArtist, Mode=OneWay}" Width="1.35*"/>
                                        <DataGridTextColumn IsReadOnly="True" Header="Album" Binding="{Binding Album, Mode=OneWay}" Width="1.2*"/>
                                        <DataGridTextColumn IsReadOnly="True" x:Name="MissingTagsColumn" Header="Missing tags" Binding="{Binding MissingTags, Mode=OneWay}" Width="1.5*" Visibility="Collapsed"/>
                                        <DataGridTextColumn IsReadOnly="True" Header="Format" Binding="{Binding Format, Mode=OneWay}" Width="72"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="#202327" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <Border Width="112" Height="112" CornerRadius="10" Background="#151719" BorderBrush="#3B424A" BorderThickness="1" HorizontalAlignment="Left" Margin="0,0,0,16">
                                        <Grid>
                                            <Image Source="Assets/DeckReady.png" Stretch="Uniform" Margin="18" Opacity="0.85"/>
                                        </Grid>
                                    </Border>

                                    <TextBlock x:Name="TagEditorSelectedTitle" Text="Select a track" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="TagEditorPathText" Text="Choose a song from the list to begin editing." Foreground="{StaticResource MutedTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,18"/>

                                    <TextBlock Text="Title" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TagTitleBox" IsEnabled="False" Margin="0,0,0,11"/>

                                    <TextBlock Text="Artist" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TagArtistBox" IsEnabled="False" Margin="0,0,0,11"/>

                                    <TextBlock Text="Album" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TagAlbumBox" IsEnabled="False" Margin="0,0,0,11"/>

                                    <Grid Margin="0,0,0,11">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Genre" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TagGenreBox" IsEnabled="False"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Year" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,4"/>
                                            <TextBox x:Name="TagYearBox" IsEnabled="False"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Background="#18282A" BorderBrush="#2B5D60" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4,0,14">
                                        <TextBlock x:Name="TagEditorStatusText" Text="Tag changes are written to the actual audio file with a safety backup and verification." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" FontSize="11"/>
                                    </Border>

                                    <WrapPanel>
                                        <Button x:Name="TagEditorPlayButton" Content="Play" IsEnabled="False" Click="TagEditorPlay_Click"/>
                                        <Button Content="Reveal" x:Name="TagEditorRevealButton" IsEnabled="False" Click="TagEditorReveal_Click"/>
                                        <Button Content="Reload Tags" x:Name="TagEditorReloadButton" IsEnabled="False" Click="TagEditorReload_Click"/>
                                        <Button Content="Save Tags" x:Name="TagEditorSaveButton" IsEnabled="False" Style="{StaticResource AccentButton}" Click="TagEditorSave_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Grid x:Name="RecentPage" Visibility="Collapsed">
                        <DataGrid x:Name="RecentGrid" ItemsSource="{Binding RecentItems}" MouseDoubleClick="RecentGrid_MouseDoubleClick" CurrentCellChanged="Grid_CurrentCellChanged">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn x:Name="RecentSelectColumn" Header="✓" Width="42" Visibility="Collapsed">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="SelectionCheckBox_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn IsReadOnly="True" Header="Title" Binding="{Binding DisplayTitle, Mode=OneWay}" Width="2*"/>
                                <DataGridTextColumn IsReadOnly="True" Header="Artist" Binding="{Binding DisplayArtist, Mode=OneWay}" Width="1.5*"/>
                                <DataGridTextColumn IsReadOnly="True" Header="Format" Binding="{Binding Format, Mode=OneWay}" Width="80"/>
                                <DataGridTextColumn IsReadOnly="True" Header="Imported" Binding="{Binding ImportedAtText, Mode=OneWay}" Width="160"/>
                                <DataGridCheckBoxColumn Header="Serato" Binding="{Binding SeratoSynced}" Width="75"/>
                                <DataGridTextColumn IsReadOnly="True" Header="Path" Binding="{Binding FilePath, Mode=OneWay}" Width="2.5*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Grid x:Name="DuplicatesPage" Visibility="Collapsed">
                        <DataGrid x:Name="DuplicatesGrid" ItemsSource="{Binding DuplicateItems}" MouseDoubleClick="DuplicatesGrid_MouseDoubleClick" CurrentCellChanged="Grid_CurrentCellChanged">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn x:Name="DuplicatesSelectColumn" Header="✓" Width="42" Visibility="Collapsed">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="SelectionCheckBox_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn IsReadOnly="True" Header="Title" Binding="{Binding DisplayTitle, Mode=OneWay}" Width="2*"/>
                                <DataGridTextColumn IsReadOnly="True" Header="Artist" Binding="{Binding DisplayArtist, Mode=OneWay}" Width="1.5*"/>
                                <DataGridTextColumn IsReadOnly="True" Header="Format" Binding="{Binding Format, Mode=OneWay}" Width="80"/>
                                <DataGridTextColumn IsReadOnly="True" Header="Existing File" Binding="{Binding FilePath, Mode=OneWay}" Width="3*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <Grid x:Name="SeratoDuplicatesPage" Visibility="Collapsed">
                        <DataGrid x:Name="SeratoDuplicatesGrid" ItemsSource="{Binding SeratoDuplicateItems}" MouseDoubleClick="SeratoDuplicatesGrid_MouseDoubleClick" CurrentCellChanged="Grid_CurrentCellChanged">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn x:Name="SeratoDuplicatesSelectColumn" Header="✓" Width="42" Visibility="Collapsed">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="SelectionCheckBox_Click"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn IsReadOnly="True" Header="Group" Binding="{Binding GroupLabel, Mode=OneWay}" Width="90"/>
                                <DataGridTextColumn IsReadOnly="True" Header="Title" Binding="{Binding DisplayTitle, Mode=OneWay}" Width="1.7*"/>
                                <DataGridTextColumn IsReadOnly="True" Header="Artist" Binding="{Binding DisplayArtist, Mode=OneWay}" Width="1.3*"/>
                                <DataGridTextColumn IsReadOnly="True" Header="Copies" Binding="{Binding DuplicateCount, Mode=OneWay}" Width="70"/>
                                <DataGridTextColumn IsReadOnly="True" Header="Crates" Binding="{Binding Crates, Mode=OneWay}" Width="1.8*"/>
                                <DataGridTextColumn IsReadOnly="True" Header="Path" Binding="{Binding FilePath, Mode=OneWay}" Width="2.7*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>

                <Border Grid.Row="2" Background="#202327" BorderBrush="#34383E" BorderThickness="0,1,0,0" Padding="14,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="SummaryText" Text="0 ready • 0 imported • 0 duplicates" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="   |   " Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" x:Name="LibraryPathText" Foreground="{StaticResource MutedTextBrush}" Text="No storage folder selected" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            </Grid>
                            <Border x:Name="NowPlayingPanel" Visibility="Collapsed" Background="#18282A" BorderBrush="#2B5D60" BorderThickness="1" CornerRadius="6" Padding="9,6" Margin="0,7,8,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Now Playing" Foreground="{StaticResource MutedTextBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Grid.Column="1" x:Name="NowPlayingText" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <StackPanel x:Name="SelectionActionsPanel" Orientation="Horizontal" Visibility="Collapsed">
                                <TextBlock x:Name="SelectedCountText" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,10,0"/>
                                <Button Content="Play" Click="BulkPlay_Click"/>
                                <Button Content="Edit Tags" Click="EditSelectedTags_Click"/>
                                <Button Content="Reveal" Click="BulkReveal_Click"/>
                                <Button x:Name="RemoveSelectedButton" Content="Remove" Click="RemoveSelected_Click" Visibility="Collapsed"/>
                            </StackPanel>
                            <Button x:Name="RetrySeratoButton" Content="Retry Serato" Click="RetrySerato_Click" Visibility="Collapsed"/>
                            <Button x:Name="ImportReadyButton" Content="Import Ready Tracks" Style="{StaticResource AccentButton}" Click="ImportReady_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
