<Window x:Class="DeckReady.Views.MetadataEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Metadata" Height="460" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource DeckReadyWindow}">
    <Grid Margin="24" Background="{StaticResource WindowBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.ColumnSpan="2" Text="Edit Track Metadata" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Title" VerticalAlignment="Center" Margin="0,6"/>
        <TextBox x:Name="TitleBox" Grid.Row="1" Grid.Column="1" Margin="0,4"/>

        <TextBlock Grid.Row="2" Text="Artist" VerticalAlignment="Center" Margin="0,6"/>
        <TextBox x:Name="ArtistBox" Grid.Row="2" Grid.Column="1" Margin="0,4"/>

        <TextBlock Grid.Row="3" Text="Album" VerticalAlignment="Center" Margin="0,6"/>
        <TextBox x:Name="AlbumBox" Grid.Row="3" Grid.Column="1" Margin="0,4"/>

        <TextBlock Grid.Row="4" Text="Genre" VerticalAlignment="Center" Margin="0,6"/>
        <TextBox x:Name="GenreBox" Grid.Row="4" Grid.Column="1" Margin="0,4"/>

        <TextBlock Grid.Row="5" Text="Year" VerticalAlignment="Center" Margin="0,6"/>
        <TextBox x:Name="YearBox" Grid.Row="5" Grid.Column="1" Margin="0,4"/>

        <TextBlock Grid.Row="6" Grid.ColumnSpan="2" x:Name="PathText" Foreground="{StaticResource MutedTextBrush}"
                   TextWrapping="Wrap" Margin="0,18,0,8"/>

        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click"/>
            <Button Content="Save Tags" Style="{StaticResource AccentButton}" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
