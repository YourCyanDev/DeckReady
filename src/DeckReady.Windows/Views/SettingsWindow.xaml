<Window x:Class="DeckReady.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeckReady Settings" Height="850" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Style="{StaticResource DeckReadyWindow}">
    <Border Background="{StaticResource WindowBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{StaticResource WindowBrush}">
            <StackPanel Margin="24">
                <TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,20"/>

                <TextBlock Text="Music Storage" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Choose where imported tracks are permanently stored." Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,10"/>
                <DockPanel>
                    <TextBox x:Name="LibraryFolderBox" IsReadOnly="True" MinWidth="470" Margin="0,0,8,0"/>
                    <Button Content="Browse..." Click="BrowseLibrary_Click"/>
                </DockPanel>

                <Separator Margin="0,20"/>

                <TextBlock Text="DeckReady Inbox" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Drop music here and DeckReady will automatically scan, import, and organize it." Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                <CheckBox x:Name="AutoImportEnabledCheck" Content="Automatically watch the DeckReady Inbox" Margin="0,0,0,8"/>
                <DockPanel>
                    <TextBox x:Name="AutoImportFolderBox" IsReadOnly="True" MinWidth="470" Margin="0,0,8,0"/>
                    <Button Content="Browse..." Click="BrowseAutoImport_Click"/>
                </DockPanel>
                <CheckBox x:Name="ClearAutoImportCheck" Content="Remove successfully imported items from the Inbox" Margin="0,10,0,4"/>
                <TextBlock Text="DeckReady scans this folder when the app starts and watches it while the app is open. Audio files, folders, and ZIP files are supported. The Inbox must be separate from your permanent music library."
                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="24,2,0,0"/>
                <TextBlock Text="With Inbox cleanup enabled, a successfully imported source folder is removed in full, including any non-audio files inside it."
                           Foreground="#F0B35A" TextWrapping="Wrap" Margin="24,5,0,0"/>

                <Separator Margin="0,20"/>

                <TextBlock Text="Import Behavior" FontSize="16" FontWeight="SemiBold"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,8">
                    <TextBlock Text="File action:" Width="170" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ImportModeBox" Width="190"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Organize by:" Width="170" VerticalAlignment="Center"/>
                    <ComboBox x:Name="OrganizationBox" Width="260"/>
                </StackPanel>
                <TextBlock Text="Year → Artist and Genre → Artist store new imports in matching folders and sync parent crates with artist subcrates containing songs. Tracks missing the selected year/genre or artist go to the need tag editing crate. Existing files stay where they are."
                           Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="170,0,0,8"/>
                <CheckBox x:Name="WriteTagsCheck" Content="Write edited metadata to the actual audio files" Margin="0,5"/>
                <CheckBox x:Name="DeleteContainerCheck" Content="Delete original ZIP or source folder after successful manual import" Margin="0,5"/>
                <TextBlock Text="Source-folder deletion is destructive and also removes non-audio files left inside that source folder."
                           Foreground="#F0B35A" TextWrapping="Wrap" Margin="24,2,0,0"/>

                <Separator Margin="0,20"/>

                <TextBlock Text="Serato" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="SeratoDetectionText" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,8" TextWrapping="Wrap"/>
                <CheckBox x:Name="AutoSeratoCheck" Content="Automatically sync new imports to Serato" Margin="0,5"/>
                <CheckBox x:Name="LaunchSeratoCheck" Content="Open Serato when sync is complete" Margin="0,5"
                          Checked="LaunchSeratoCheck_Changed" Unchecked="LaunchSeratoCheck_Changed"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Open after sync:" Width="170" VerticalAlignment="Center"/>
                    <ComboBox x:Name="PreferredSeratoBox" Width="220"/>
                </StackPanel>
                <TextBlock x:Name="PreferredSeratoHelpText" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="170,5,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="Crate name:" Width="170" VerticalAlignment="Center"/>
                    <TextBox x:Name="CrateNameBox" Width="300"/>
                </StackPanel>
                <TextBlock Text="For safe crate updates, DeckReady syncs while Serato is closed. Year/artist and genre/artist modes use tag names instead of the single crate name." Foreground="{StaticResource MutedTextBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,28,0,0">
                    <Button Content="Cancel" Click="Cancel_Click"/>
                    <Button Content="Save" Style="{StaticResource AccentButton}" Click="Save_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
