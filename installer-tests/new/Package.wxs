<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Id="YourCyanDev.DeckReady" Name="DeckReady" Manufacturer="YourCyanDev" Version="1.7.11" Scope="perMachine">
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of DeckReady is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="DeckReady" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="CREATE_DESKTOP_SHORTCUT" Value="1" Secure="yes" />
    <UIRef Id="DeckReadyUI_InstallDir" />
    <WixVariable Id="WixUIDialogBmp" Value="Assets\InstallerDialog.png" />
    <WixVariable Id="WixUIBannerBmp" Value="Assets\InstallerBanner.png" />
    <WixVariable Id="WixUILicenseRtf" Value="Assets\License.rtf" />

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">
      <Component Id="DeckReadyExecutable" Guid="*">
        <File Id="DeckReadyExe" Source="payload\DeckReady.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="ShortcutComponents" Directory="ProgramMenuFolder">
      <Component Id="DeckReadyStartMenuShortcutComponent" Guid="*">
        <Shortcut Id="DeckReadyStartMenuShortcut" Name="DeckReady" Description="DeckReady" Target="[INSTALLFOLDER]DeckReady.exe" WorkingDirectory="INSTALLFOLDER" Advertise="no" />
        <RegistryValue Root="HKCU" Key="Software\YourCyanDev\DeckReady" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="DesktopShortcutComponents" Directory="DesktopFolder">
      <Component Id="DeckReadyDesktopShortcutComponent" Guid="*">
        <Shortcut Id="DeckReadyDesktopShortcut" Name="DeckReady" Description="DeckReady" Target="[INSTALLFOLDER]DeckReady.exe" WorkingDirectory="INSTALLFOLDER" Advertise="no" />
        <RegistryValue Root="HKLM" Key="Software\YourCyanDev\DeckReady" Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="DeckReady" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentGroupRef Id="ShortcutComponents" />
    </Feature>
    <Feature Id="DesktopShortcutFeature" Title="Desktop Shortcut" Description="Create a DeckReady shortcut on the desktop." Level="1" AllowAbsent="yes">
      <ComponentGroupRef Id="DesktopShortcutComponents" />
    </Feature>
  </Package>
</Wix>
